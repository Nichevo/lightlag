<Project Sdk="Godot.NET.Sdk/4.7.2">
  <!-- The Godot game: screens, drawing and input only. Game rules live in src/Lightlag.Sim. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RootNamespace>Lightlag.Game</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Approved ship and idea drawings (SVG), loaded at run time by Art.cs. Godot ignores the folder (.gdignore). -->
    <EmbeddedResource Include="Art/**/*.svg" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../src/Lightlag.Sim/Lightlag.Sim.csproj" />
  </ItemGroup>
</Project>
