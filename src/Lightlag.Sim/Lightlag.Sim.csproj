<Project Sdk="Microsoft.NET.Sdk">
  <!-- The simulation core. It must never reference Godot, so it can run headless and in tests. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lightlag.Sim</RootNamespace>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Game data ships inside the simulation so the game, the headless runner and the tests all read the same files. -->
    <EmbeddedResource Include="Data/*.json" LogicalName="Lightlag.Data.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
